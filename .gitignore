# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?

# Local environment and secrets
.env
.env.*
!.env.example
.venv/
venv/
backend/.venv/
frontend/.env
frontend/.env.*
backend/.env
# Cloud Run deploy settings (see backend/README.md)
backend/cloudrun.env.yaml
backend/.env.*
# Re-allow the templates after the folder rules above (last match wins).
!.env.example

# Python caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Build-time job vectors (python -m app.precompute_job_vectors)
backend/precomputed/

# Local research corpus (ESCO bulk files, taxonomy workbook, annotation pool).
# backend/pipeline/config.py and backend/models/config.py create these folders
# on import; the data stays on the maintainer's machine.
backend/data/corpus/

# Listing export from: python -m backend.scripts.import_jooble_jobs --csv ...
jooble_listings*.csv

# Runtime files and private uploads
uploads/
backend/uploads/
frontend/uploads/
tmp/
temp/
backend/tmp/
frontend/tmp/
*.log
*.pid
.uvicorn*
backend/.uvicorn*

# Frontend dependencies and builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
.vite/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel local project metadata
.vercel/
frontend/.vercel/

# Supabase local development files
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*

# Downloaded model caches
.cache/
huggingface/
transformers_cache/
backend/.cache/
backend/huggingface/
backend/transformers_cache/

# Large model and machine-learning artifacts
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# Verified production bi-encoder required by the matching API (no training data).
!backend/trained_models/kareerly-bi-encoder/model.safetensors

# Optional generated ML artifacts
backend/models/*.joblib
backend/models/*.pkl
backend/models/*.npz

# Large legacy source data retained locally for evaluation
backend/evaluation/source_data/jobs_record_source.csv

# Local database exports and backups
*.dump
*.sql.gz
*.backup
database-backups/
backups/

# Private user documents
*.pem
*.key
*.p12
*.pfx
