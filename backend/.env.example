SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MESSAGE_ENCRYPTION_KEY=
# Cloud Run: include the exact public Vercel website origin, not the Vercel dashboard URL
# (set in backend/cloudrun.env.yaml when deploying; see backend/README.md).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# Set to 0 to skip warming the encoder and job vectors at startup.
KAREERLY_WARM_ON_STARTUP=1
# Optional override; defaults to the bundled, fine-tuned checkpoint.
KAREERLY_BI_ENCODER_MODEL_PATH=
# Optional overrides of the calibrated defaults in app/services/match_scoring.py;
# see docs/matching-diagnosis.md before changing them.
KAREERLY_FIT_NOW_MIN_COSINE=0.45
KAREERLY_FIT_NOW_MIN_COVERAGE=0.70
KAREERLY_ASPIRATION_MIN_COSINE=0.20
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Gemma4 is called through an OpenAI-compatible chat-completions endpoint.
# Leave GEMMA_BASE_URL empty to use the deterministic extraction/explanation fallback.
GEMMA_MODEL=google/gemma-4-26B-A4B-it
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=30
# Jooble API key for scripts/import_jooble_jobs.py (maintainer machine or GitHub Actions only;
# the deployed backend never calls Jooble). JOOBLE_HOST defaults to ph.jooble.org.
JOOBLE_API_KEY=
# PSA Classifications API token, used only by scripts/import_reference_data.py psoc
# on a maintainer's machine. Never commit it and never set it on the deployed backend:
# the backend reads the published copy in data/psoc/ and makes no PSA API calls.
PSA_API_TOKEN=
# Days before /api/health/config reports the PSOC reference as stale (default 365).
PSOC_REFERENCE_MAX_AGE_DAYS=365
# Requests per client address per window on the costly public endpoints
# (app/rate_limit.py). Defaults: RESUME 60/600, MATCHING 120/600,
# CERTIFICATE 60/600. "off" disables a bucket.
# KAREERLY_RATE_LIMIT_RESUME=60/600
# KAREERLY_RATE_LIMIT_MATCHING=120/600
# KAREERLY_RATE_LIMIT_CERTIFICATE=60/600
# Aspiration lists jobs scoring at least this first (app/services/match_scoring.py).
# KAREERLY_ASPIRATION_RELEVANT_MIN_SCORE=0.30
