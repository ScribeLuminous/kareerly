# Files `gcloud run deploy --source backend` does not upload. It reads this file
# (not .dockerignore) before Cloud Build sees .dockerignore, so without it a
# local virtual environment (several GB) would be uploaded on every deploy.
.gcloudignore
.git/
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.*
!.env.example
cloudrun.env.yaml
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
uploads/
tmp/
temp/
*.ipynb
node_modules/
dist/
# Regenerated by the Dockerfile during the build.
precomputed/
